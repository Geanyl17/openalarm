<?xml version="1.0" encoding="utf-8"?>
<!-- No INTERNET permission: OpenAlarm works fully offline, and `./gradlew check` fails if a library adds it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Showing the ringing alarm, over the lock screen. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Ringing at the exact minute: USE_EXACT_ALARM from Android 13, SCHEDULE_EXACT_ALARM before that. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- Ringing: a foreground service that keeps the phone awake and vibrates. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Bringing the ringing screen back when the user leaves it before turning the alarm off. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Counts steps for the Steps mission, and lets check-ins be skipped for someone walking around. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Re-arming alarms after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".OpenAlarmApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenAlarm">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Everything below also runs before the first unlock after a reboot (Direct Boot). -->
        <activity
            android:name=".ringing.RingingActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:turnScreenOn="true"
            tools:targetApi="o_mr1" />

        <service
            android:name=".ringing.RingingService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />

        <receiver
            android:name=".alarm.AlarmReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!-- Exported only for system broadcasts, which other apps can't send. -->
        <receiver
            android:name=".alarm.RescheduleReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
